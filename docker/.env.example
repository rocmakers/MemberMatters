# Copy to .env and replace the placeholders:
#   cp .env.example .env
#
# Compose reads this file automatically when you run
# `docker compose up` from the docker/ directory.

MM_SECRET_KEY=change-me-to-a-long-random-string
POSTGRES_USER=membermatters
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=membermatters

# Optional; compose defaults to latest and 8000 if unset.
MM_IMAGE_TAG=latest
MM_HOST_PORT=8000
